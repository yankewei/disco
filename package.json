{
  "name": "disco-electron",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-node/main/index.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:main": "tsc -p tsconfig.node.json",
    "build": "npm run build:main && vite build",
    "start": "electron .",
    "test": "vitest run",
    "package": "npm run build && electron-builder --mac universal"
  },
  "build": {
    "appId": "ai.disco.desktop",
    "productName": "Disco",
    "files": [
      "dist-node/**",
      "dist-renderer/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": "${CSC_NAME}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "${DISCO_UPDATE_URL}"
      }
    ],
    "dmg": {
      "sign": false
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.251",
    "@openai/codex-sdk": "^0.151.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "typescript": "latest",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "latest"
  }
}
